# ============================================================
# SAPA BPS 1901 - FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================================
# Salin file ini menjadi .env.local untuk menggunakannya:
# cp .env.example .env.local

# URL Internal Backend Server Express (Port 8000)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# URL Publik Backend API
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Konfigurasi Aplikasi & Wilayah Kerja BPS
NEXT_PUBLIC_APP_NAME="SAPA BPS 1901"
NEXT_PUBLIC_BPS_REGION="Kabupaten Bangka"
NEXT_PUBLIC_BPS_CODE="1901"
NEXT_PUBLIC_APP_VERSION="2.1.0"
